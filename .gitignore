# ------------------------------------------------------------------
# 运行时数据 —— 首次启动自动播种，随时可删
#   server/data/db.json        单文件数据库（种子 + 你操作产生的数据）
#   server/data/workspace/     每个会话一个真实工作目录
#   server/data/hosts/         主机虚拟盘
#   server/data/skills/        技能文件落盘处
#   server/data/files/         附件与直链
#   server/data/attachments/   工单附件
# ------------------------------------------------------------------
server/data/

# ------------------------------------------------------------------
# 本地调试日志（docs/ 下的验收日志是交付物，必须保留）
# ------------------------------------------------------------------
/*.log
!/docs/*.log

# ------------------------------------------------------------------
# 常规
# ------------------------------------------------------------------
node_modules/
__pycache__/
*.pyc
.venv/
venv/

.DS_Store
Thumbs.db
desktop.ini

.idea/
.vscode/
*.swp

.env
.env.*
!.env.example

# reverse-skill 案卷（本地分析工件，不入仓）
work/
.live/
strix_runs/
